# Dependencies
node_modules/
vendor/

# Build artefacts produced by tooling not yet committed
# (build/ from @wordpress/scripts is intentionally NOT ignored — it is committed)
*.log
.phpunit.result.cache
.phpunit.cache/
coverage/
.npm/

# Release artefacts emitted by ./build-zip.sh (and the release workflow) —
# uploaded to the GitHub release as an asset, not committed.
/dist/

# Playwright e2e artifacts — auth storage state (a generated login, also a minor
# credential), generated JPEG fixtures (regenerated by tests/e2e/global-setup.ts),
# test results, and the HTML / blob reports — all regenerated on each run.
/tests/e2e/.auth/
/tests/e2e/fixtures/
/tests/e2e/test-results/
/tests/e2e/playwright-report/
/tests/e2e/blob-report/
/playwright/.cache/

# Editor / OS files
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local AI-agent config (Claude Code etc.) — per-developer, not project content.
# Skills under .claude/skills/ encode project-specific procedure and ARE committed.
.claude/*
!.claude/skills/

# Local config
.env
.env.local

# Composer / npm lock files are kept (committed)
